# Copy these names into Coolify → Environment Variables. Do NOT put real values in git.
SECRET_KEY=            # long random string
DATABASE_URL=          # postgres://USER:PASSWORD@HOST:5432/DBNAME  (Coolify's internal Postgres URL)
ALLOWED_HOSTS=         # crm.example.com
CSRF_TRUSTED_ORIGINS=  # https://crm.example.com
OPENROUTER_API_KEY=    # project-specific key
INGEST_TOKEN=          # optional, long random string for the office VoIP uploader
# Optional
# TRANSCRIBE_MODEL=google/gemini-2.5-flash
# ANALYZE_MODEL=google/gemini-2.5-flash
# WEB_WORKERS=3
# SECURE_COOKIES=true   # set false only while testing over plain http
